<Project>
  <!-- Every test project names itself with IsTestProject and gets the same test framework. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>
  <!-- A test builds its expected array once, so a constant array argument costs nothing. -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>
</Project>

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,axaml,json,yml}]
indent_size = 2

[*.cs]
# F2: cyclomatic complexity of 10 or less. The threshold is in CodeMetricsConfig.txt.
dotnet_diagnostic.CA1502.severity = error
# F3: unused private members are errors.
dotnet_diagnostic.IDE0051.severity = error
dotnet_diagnostic.IDE0052.severity = error
